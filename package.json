{
  "name": "vsc-postman",
  "private": true,
  "version": "3.1.1",
  "type": "module",
  "description": "HTTP client for VS Code: send REST requests, inspect responses, and manage collections and request history.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bingcoder/vsc-postman.git"
  },
  "bugs": {
    "url": "https://github.com/bingcoder/vsc-postman/issues"
  },
  "homepage": "https://github.com/bingcoder/vsc-postman#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:extension": "tsc -b && vite build --config src-extension/vite.config.ts",
    "dev:extension": "vite build --config src-extension/vite.config.ts --watch",
    "compile:vsc": "tsc -p src-vsc/tsconfig.json",
    "build:vsc": "node scripts/build-vsc.mjs",
    "watch:vsc": "tsc -w -p src-vsc/tsconfig.json",
    "smoke:extension": "node --experimental-websocket scripts/extension-smoke.mjs",
    "smoke:extension:fetch": "node --experimental-websocket scripts/extension-integration-smoke.mjs",
    "smoke:migrate": "node scripts/migrate-smoke/run.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "release:bump": "node scripts/release-bump.mjs",
    "package:vsix": "bash scripts/package-vsix.sh",
    "package:extension": "node scripts/package-extension.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.18.1",
    "react-router-dom": "^7.9.0",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4"
  }
}
